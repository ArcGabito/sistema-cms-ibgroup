# Password of the development SQL Server's sa login (docker-compose.yml);
# the server connects with it. Development only. scripts/setup.sh generates
# one; SQL Server requires 8+ characters mixing upper, lower, digits and symbols.
DB_SA_PASSWORD=

# Signing key for backend JWTs. Generate your own with: openssl rand -hex 32
JWT_KEY=

# Password of the admin account (user "admin"). Private: never shown on the
# site. scripts/setup.sh generates one. Every startup restores the admin with
# it, so rotating it is changing it here (Seed__AdminPassword on the server).
ADMIN_PASSWORD=

# Public demo account: an Editor (blog and site content; contacts, test
# results, clients and users stay admin-only) whose credentials the sign-in
# page shows. Every startup restores it and it can't change its password.
# Leave DEMO_USERNAME empty for no demo account. In production these go on the
# server as Seed__DemoUsername / Seed__DemoPassword and on Vercel as
# DEMO_USERNAME / DEMO_PASSWORD (same values).
DEMO_USERNAME=demo
DEMO_PASSWORD=Demo2026!

# Optional: powers the "Automatización IA" blog draft generator.
# Without it, that module stays disabled with a clear message instead of failing.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Public origin of the site (sitemap.xml, robots.txt, Open Graph URLs).
SITE_URL=http://localhost:3000
