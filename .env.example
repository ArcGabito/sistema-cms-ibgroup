# Used only to provision the database (docker/database/init.sql) — the
# backend itself connects as APP_DB_USER below, never as sa.
DB_SA_PASSWORD=YourStrong!Passw0rd

# Dedicated, least-privilege SQL Server login the backend actually connects
# with (db_owner scoped to IBGroupCMS only — never sysadmin).
APP_DB_USER=ibgroup_app
APP_DB_PASSWORD=AppUser_Str0ng!Pass

# Signing key for backend JWTs. Generate your own with: openssl rand -hex 32
JWT_KEY=1d0bc84ff998b7e3d0dc691f274ebe017a3023f6e148b781225a91fadd99eee6

# Seeded admin user (created once, on first startup, if the Users table is empty)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_FULLNAME=Administrador

# Optional: powers the "Automatización IA" blog draft generator.
# Without it, that module stays disabled with a clear message instead of failing.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
