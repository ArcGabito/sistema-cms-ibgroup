# Password of the development SQL Server's sa login (docker-compose.yml);
# the server connects with it. Development only. scripts/setup.sh generates
# one; SQL Server requires 8+ characters mixing upper, lower, digits and symbols.
DB_SA_PASSWORD=

# Signing key for backend JWTs. Generate your own with: openssl rand -hex 32
JWT_KEY=

# The demo admin (admin / Admin123!) is defined in core/server/appsettings.json
# and restored on every startup; it isn't configured here.

# Optional: powers the "Automatización IA" blog draft generator.
# Without it, that module stays disabled with a clear message instead of failing.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Public origin of the site (sitemap.xml, robots.txt, Open Graph URLs).
SITE_URL=http://localhost:3000
